using sysbus

# B-U585I-IOT02A (STM32U585, Cortex-M33) — wasmbed OCRE firmware
# Note: the real board uses SPI WiFi (ISM43362/eswifi).
# In Renode emulation we attach a virtual TAP Ethernet for host connectivity.
# The firmware built for Renode uses CONFIG_NET_DRIVER_AT=n and a synthetic
# Ethernet MAC mapped to the SPI WiFi bus address.

mach create "b_u585i_iot02a"
machine LoadPlatformDescription @platforms/boards/b_u585i_iot02a.repl

showAnalyzer sysbus.usart1

sysbus LoadELF @{ELF_PATH}

# Virtual network: TAP interface bound to the WiFi MAC peripheral address
emulation CreateSwitch "wifi_switch"
emulation CreateTap "tap0" "wifi_tap"
sysbus.wifi MAC "02:00:00:00:00:01"
connector Connect sysbus.wifi wifi_switch
connector Connect host.wifi_tap wifi_switch
host.wifi_tap Start

# Gateway endpoint injected at known SRAM address (same protocol as other boards)
# Length + ASCII endpoint string written by RenodeManager
{ENDPOINT_WRITES}

logLevel -1
start
