/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * DTS overlay for B-U585I-IOT02A — Renode emulation variant.
 * Replaces ISM43362 WiFi with SMSC LAN91C111 Ethernet (emulated by Renode
 * Network.SMC91X at 0x60000000) and adds OCRE LittleFS storage partition.
 *
 * Fixed-link PHY avoids MDIO bit-bang negotiation (not needed in simulation).
 * The smsc,lan91c111-mdio node must exist (driver always instantiates it),
 * but no PHY child is needed since we use ethernet-phy-fixed-link.
 *
 * Clock: use MSIS directly (no PLL) to avoid complex PLL emulation in Renode.
 * MSIS range=4 = 4 MHz; all prescalers = 1. PLL1 disabled.
 */

/* MSIS at 4 MHz as system clock — no PLL needed in simulation */
&clk_msis {
	status = "okay";
	msi-range = <4>;
};

&pll1 {
	status = "disabled";
};

&rcc {
	clocks = <&clk_msis>;
	clock-frequency = <DT_FREQ_M(4)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <1>;
	apb2-prescaler = <1>;
	apb3-prescaler = <1>;
};

/*
 * Disable all peripherals not used in Renode simulation.
 * Only USART1 (console) and Ethernet (SMSC91X) are needed.
 * Disabling prevents driver init spin-loops on unmodeled registers.
 */
&spi1    { status = "disabled"; };  /* ISM43362 WiFi */
&usart3  { status = "disabled"; };  /* Arduino serial */
&uart4   { status = "disabled"; };  /* secondary UART */
&i2c1    { status = "disabled"; };  /* sensors I2C bus */
&i2c2    { status = "disabled"; };  /* sensors I2C bus */
&adc1    { status = "disabled"; };
&adc4    { status = "disabled"; };
&dac1    { status = "disabled"; };
&aes     { status = "disabled"; };
&die_temp { status = "disabled"; };
&rtc     { status = "disabled"; };
&iwdg    { status = "disabled"; };  /* watchdog: must be disabled to prevent reset */
&vref1   { status = "disabled"; };
&vbat4   { status = "disabled"; };
&timers3 { status = "disabled"; };
&timers4 { status = "disabled"; };
/* octospi1/2 and mx25lm51245 must remain enabled — octospi2 has IRQ 120 which sets
   CONFIG_NUM_IRQS; disabling it causes gen_isr_tables failure (IRQ 120 > max 94) */
/* &gpdma1 must remain enabled — same reason */

/*
 * SMSC LAN91C111 Ethernet — Renode Network.SMC91X @ 0x60000000.
 * Container provides MMIO base (both children use DT_PARENT for reg addr).
 * 0x60000000 is in the STM32U585 external memory range (FMC/OCTOSPI), unused.
 */
/ {
	ethernet_container: ethernet@60000000 {
		reg = <0x60000000 0x10000>;
		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0x0 0x60000000 0x10000>;

		lan91c111: ethernet {
			compatible = "smsc,lan91c111";
			interrupts = <72 0>;
			interrupt-parent = <&nvic>;
			status = "okay";
			phy-handle = <&phy0>;
		};

		/* MDIO node required by driver compilation even with fixed-link PHY */
		lan91_mdio: mdio {
			compatible = "smsc,lan91c111-mdio";
			status = "okay";
			#address-cells = <1>;
			#size-cells = <0>;
		};
	};

	/* Fixed-link PHY: always-up at 100BASE Full-Duplex, no MDIO needed */
	phy0: ethernet-phy-fixed-link {
		compatible = "ethernet-phy-fixed-link";
		status = "okay";
		default-speeds = "100BASE Full-Duplex";
	};
};

/* Flash partition table */
&flash0 {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        boot_partition: partition@0 {
            label = "mcuboot";
            reg = <0x00000000 DT_SIZE_K(64)>;
            read-only;
        };

        slot0_partition: partition@10000 {
            label = "image-0";
            reg = <0x00010000 DT_SIZE_K(1728)>;
        };

        ocre_storage_partition: partition@1C0000 {
            label = "ocre-storage";
            reg = <0x001C0000 DT_SIZE_K(256)>;
        };
    };
};

/* Mount OCRE storage partition as LittleFS at /lfs/ocre */
/ {
    fstab {
        compatible = "zephyr,fstab";
        lfs0: lfs0 {
            compatible = "zephyr,fstab,littlefs";
            mount-point = "/lfs/ocre";
            partition = <&ocre_storage_partition>;
            read-size = <16>;
            prog-size = <16>;
            cache-size = <64>;
            lookahead-size = <32>;
            block-cycles = <512>;
        };
    };
};
