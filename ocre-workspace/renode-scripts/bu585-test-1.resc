using sysbus
mach create "bu585-test-1"
machine LoadPlatformDescription @/scripts/b_u585i_iot02a.repl
showAnalyzer sysbus.usart1
sysbus LoadELF @/firmware/bu585-test-1/zephyr.elf
emulation CreateSwitch "ethernet_switch"
emulation CreateTap "tap0" "ethernet_tap"
sysbus.smsc91x MAC "02:00:00:00:00:01"
connector Connect sysbus.smsc91x ethernet_switch
connector Connect host.ethernet_tap ethernet_switch
host.ethernet_tap Start
sysbus WriteDoubleWord 0x20001000 0x00000015
sysbus WriteDoubleWord 0x20001004 0x2e323931
sysbus WriteDoubleWord 0x20001008 0x2e383631
sysbus WriteDoubleWord 0x2000100c 0x2e303031
sysbus WriteDoubleWord 0x20001010 0x3a393731
sysbus WriteDoubleWord 0x20001014 0x34343033
sysbus WriteDoubleWord 0x20001018 0x00000033
logLevel -1
start
